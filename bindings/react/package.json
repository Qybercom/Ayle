{
	"name": "@qybercom/ayle-react",
	"version": "0.0.0-development",
	"description": "React binding for Ayle media player",
	"type": "module",
	"files": [
		"dist/",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"@qybercom/ayle": ">=0.0.0",
		"react": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"build": "node ../../scripts/build-react.mjs",
		"check": "node ../../scripts/check-react.mjs",
		"prepack": "npm run build && npm run check"
	}
}