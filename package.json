{
	"name": "@qybercom/ayle",
	"version": "0.0.0-development",
	"description": "Ayle framework-independent media player",
	"type": "module",
	"sideEffects": [
		"./dist/ayle.css",
		"./dist/ayle.js",
		"./dist/ayle-bootstrap.js",
		"./dist/ayle.esm.js",
		"./dist/ayle-bootstrap.esm.js"
	],
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": "./dist/ayle.esm.js",
		"./ayle.js": "./dist/ayle.js",
		"./ayle.min.js": "./dist/ayle.min.js",
		"./ayle-bootstrap.js": "./dist/ayle-bootstrap.js",
		"./ayle-bootstrap.min.js": "./dist/ayle-bootstrap.min.js",
		"./ayle.css": "./dist/ayle.css",
		"./ayle.min.css": "./dist/ayle.min.css",
		"./ayle-icons.svg": "./dist/ayle-icons.svg",
		"./package.json": "./package.json",
		"./bootstrap": "./dist/ayle-bootstrap.esm.js",
		"./icons": "./dist/ayle-icons.svg",
		"./icons/chapters.svg": "./dist/icons/chapters.svg",
		"./icons/fullscreen-enter.svg": "./dist/icons/fullscreen-enter.svg",
		"./icons/fullscreen-exit.svg": "./dist/icons/fullscreen-exit.svg",
		"./icons/loading.svg": "./dist/icons/loading.svg",
		"./icons/pause.svg": "./dist/icons/pause.svg",
		"./icons/pip.svg": "./dist/icons/pip.svg",
		"./icons/play.svg": "./dist/icons/play.svg",
		"./icons/settings.svg": "./dist/icons/settings.svg",
		"./icons/volume.svg": "./dist/icons/volume.svg"
	},
	"scripts": {
		"clean": "node scripts/build.mjs --clean",
		"build:core": "node scripts/build.mjs",
		"build:react": "node scripts/build-react.mjs",
		"build:angular": "node scripts/build-angular.mjs",
		"sync:angular-example": "node scripts/sync-angular-example.mjs",
		"prepare:angular-example": "node scripts/prepare-angular-example.mjs",
		"build": "npm run build:core && npm run build:react && npm run build:angular",
		"check:core": "node scripts/check.mjs",
		"check:react": "node scripts/check-react.mjs",
		"check:angular": "node scripts/check-angular.mjs",
		"check": "npm run check:core && npm run check:react && npm run check:angular",
		"pack:check": "npm pack --dry-run && npm pack --dry-run ./bindings/react && npm pack --dry-run ./bindings/angular/dist",
		"prepack": "npm run build:core && npm run check:core"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"devDependencies": {
		"esbuild": "^0.25.0"
	}
}