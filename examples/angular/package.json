{
	"name": "ayle-angular-example",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"prepare:ayle": "node ../../scripts/prepare-angular-example.mjs",
		"prestart": "npm run prepare:ayle",
		"start": "ng serve --proxy-config proxy.conf.json",
		"prebuild": "npm run prepare:ayle",
		"build": "ng build",
		"pretypecheck": "npm run prepare:ayle",
		"typecheck": "ng build --configuration development",
		"audit": "npm audit",
		"audit:runtime": "npm audit --omit=dev"
	},
	"dependencies": {
		"@angular/common": "^22.1.0",
		"@angular/compiler": "^22.1.0",
		"@angular/core": "^22.1.0",
		"@angular/platform-browser": "^22.1.0",
		"@qybercom/ayle": "file:../..",
		"@qybercom/ayle-angular": "file:../../bindings/angular/dist",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular/cli": "^22.1.0",
		"@angular/compiler-cli": "^22.1.0",
		"typescript": "^6.0.0",
		"@angular/build": "^22.1.0"
	}
}